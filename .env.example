# Application environment
APP_ENV=local
APP_VERSION=dev
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/symptom_checker

# Security
JWT_SECRET=local-development-secret-that-is-at-least-32-chars-long

# AI & ML Providers (mock in local development and CI)
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

CV_PROVIDER=mock
CV_MODEL_REPO=NT1906/skin-cv
CV_MODEL_REVISION=main
