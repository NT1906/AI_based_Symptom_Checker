# Copy to /opt/symptom-checker/.env on the VPS and fill in. Never commit the real file.
APP_ENV=production
API_DOMAIN=api.example.com

DATABASE_URL=postgresql+psycopg://user:password@host/dbname
JWT_SECRET=change-me-to-64-random-characters

AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=

CV_PROVIDER=onnx
CV_MODEL_REPO=
CV_MODEL_REVISION=

# Only when running the optional local-db profile:
# POSTGRES_PASSWORD=
